module(
    name = "rules_bun",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "bazel_lib", version = "3.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")

# On any hermetic_launcher bump, check hermetic-launcher#81 (G4) and #80 (G1).
bazel_dep(name = "hermetic_launcher", version = "0.0.16")
bazel_dep(name = "package_metadata", version = "0.0.6")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.6.1")

bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True, repo_name = "bazel_gazelle")

bun_dev = use_extension("//bun:extensions.bzl", "bun", dev_dependency = True)
bun_dev.toolchain(bun_version = "1.4.2")
use_repo(bun_dev, "bun_darwin-aarch64", "bun_darwin-x64", "bun_linux-aarch64", "bun_linux-x64", "bun_toolchains", "bun_windows-x64")

register_toolchains(
    "@bun_toolchains//:all",
    dev_dependency = True,
)

# Results of the pure npm modules on the fixture lockfiles, for the unit tests.
fixture_results = use_extension("//bun/tests/npm:fixture_results.bzl", "fixture_results", dev_dependency = True)
use_repo(fixture_results, "npm_fixture_results")

