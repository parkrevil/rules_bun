load("@bazel_lib//:bzl_library.bzl", "bzl_library")

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//bun/private:library",
        "//bun/private:providers",
        "//bun/private:run",
    ],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//bun/private:toolchain"],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    visibility = ["//visibility:public"],
    deps = [
        "//bun/private:extensions",
        "//bun/private:npm_extension",
    ],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    visibility = ["//visibility:public"],
    deps = ["//bun/private:repositories"],
)

# The files a consumer of the module needs, for the Bazel-in-Bazel tests (G5).
filegroup(
    name = "all_files",
    srcs = glob(["*"]) + [
        "//bun/platforms/libc:all_files",
        "//bun/private:all_files",
        "//bun/private/windows_launcher:all_files",
        "//bun/toolchain:all_files",
    ],
    visibility = [
        "//:__pkg__",
        "//bun/tests:__subpackages__",
    ],
)
