load("//bun:defs.bzl", "bun_binary", "bun_library", "bun_test")
load("//bun/tests/integration/registry:archives.bzl", "ARCHIVES")
load(":inner_inputs.bzl", "inner_inputs")

# The Bazel-in-Bazel tests are tagged requires-network, as tools/preset.bazelrc
# asks of tests that need network access: macOS's sandbox with network denied
# keeps the inner Bazel's JVM from reaching the loopback registry. On Linux,
# .bazelrc adds block-network to every test, which takes precedence (Bazel's
# Spawns.requiresNetwork), so the inner builds stay offline there.

# The pinned Bazel of the platform the test runs on (G10).
alias(
    name = "bazel_binary",
    actual = select({
        ":darwin_aarch64": "@integration_bazel_darwin_arm64//file",
        ":darwin_x86_64": "@integration_bazel_darwin_x86_64//file",
        ":linux_aarch64": "@integration_bazel_linux_arm64//file",
        ":windows_x86_64": "@integration_bazel_windows_x86_64//file",
        "//conditions:default": "@integration_bazel_linux_x86_64//file",
    }),
)

[
    config_setting(
        name = name,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for name, os, cpu in [
        ("darwin_aarch64", "macos", "aarch64"),
        ("darwin_x86_64", "macos", "x86_64"),
        ("linux_aarch64", "linux", "aarch64"),
        ("windows_x86_64", "windows", "x86_64"),
    ]
]

filegroup(
    name = "workspace_files",
    srcs = glob(["workspaces/**"]),
)

inner_inputs(
    name = "inner_inputs",
    archives = {"@" + repo + "//file": path for repo, path in ARCHIVES.items()},
    bazel = ":bazel_binary",
    registry = "//bun/tests/integration/registry:files",
    rules_bun = "//:rules_bun_files",
    workspaces = ":workspace_files",
)

bun_library(
    name = "inner",
    srcs = [
        "support/inner.ts",
        "support/secrets.ts",
    ],
    data = [":inner_inputs"],
    visibility = ["//bun/tests:__subpackages__"],
    deps = ["//bun/tests/support:npm_registry"],
)

bun_test(
    name = "harness_test",
    size = "enormous",
    srcs = ["harness.test.ts"],
    tags = ["requires-network"],
    deps = [":inner"],
)

