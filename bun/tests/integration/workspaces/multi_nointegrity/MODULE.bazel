# Two hubs, one of whose lockfiles records no integrity for b@1.0.0 (US2).
bazel_dep(name = "rules_bun")

bun = use_extension("@rules_bun//bun:extensions.bzl", "bun")
bun.toolchain(bun_version = "1.4.4")
use_repo(bun, "bun_toolchains")

register_toolchains("@bun_toolchains//:all")

npm = use_extension("@rules_bun//bun:extensions.bzl", "npm")
npm.translate_lock(
    name = "npm_one",
    bun_lock = "//one:bun.lock",
)
npm.translate_lock(
    name = "npm_two",
    bun_lock = "//two:bun.lock",
)
use_repo(npm, "npm_one", "npm_two")
