load("@npm//:defs.bzl", "npm_link_all_packages")

exports_files(["bun.lock"])

npm_link_all_packages()

# The platform restricted.test.ts builds for, whatever the host.
platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# The platform bin-darwin-arm64 is for.
platform(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)
