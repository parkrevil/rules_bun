load("@npm_workspace//:defs.bzl", "npm_link_all_packages")
load("//bun:defs.bzl", "bun_binary", "bun_test")

npm_link_all_packages()

# w1's own versions and its four dependency kinds (US4-1, US4-2, US4-3, US4-6).
bun_test(
    name = "w1_test",
    srcs = ["w1.test.ts"],
    deps = [
        ":node_modules/a",
        ":node_modules/q",
        ":node_modules/single-bin",
        ":node_modules/state",
        ":node_modules/w2",
    ],
)

# Imports the optional dependency native-linux-x64, carried on Linux x64 only
# (US4-6); started by optional_test.
bun_binary(
    name = "optional",
    entry_point = "optional_main.ts",
    tags = ["manual"],
    visibility = ["//bun/tests/npm:__subpackages__"],
    deps = [":node_modules/native-linux-x64"],
)

bun_test(
    name = "optional_test",
    srcs = ["optional.test.ts"],
    data = [":optional"],
    deps = ["//bun/tests/support:spawn"],
)
