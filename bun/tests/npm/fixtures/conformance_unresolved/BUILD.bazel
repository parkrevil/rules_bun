load("@npm_conformance_unresolved//:defs.bzl", "npm_link_all_packages")
load("//bun/tests/npm:generated_names.bzl", "generated_names_test")
load("//bun/tests/npm/conformance:files.bzl", "conformance_files")

exports_files([
    "bun.lock",
    "package.json",
])

# T111 (feature 006): every declared dependency has its target, also one the store links on no
# platform class; //bun/tests/npm:declared checks that such a target carries nothing. T169: the
# unresolved single-bin keeps the bin target of the row `main` linked it to (w's
# single-bin@1.0.0), compatible with no platform.
npm_link_all_packages()

generated_names_test(
    name = "names_test",
    expected = [
        "node_modules/a",
        "node_modules/b",
        "node_modules/opt-user",
        "node_modules/q",
        "node_modules/single-bin",
        "node_modules/single-bin/bin/single-bin",
        "node_modules/state",
    ],
    expected_incompatible = [
        "node_modules/single-bin/bin/single-bin",
    ],
)

conformance_files()
