bun_library(
    name = "member_lib",
    srcs = ["//bun/tests/npm/fixtures/conformance_member_alias/packages/member-lib:index.js"],
    data = ["//bun/tests/npm/fixtures/conformance_member_alias/packages/member-lib:package.json"],
    visibility = ["//bun/tests/npm/fixtures/conformance_member_alias/packages/member-lib:__pkg__"],
)

# BC-4 (feature 006): member-user@1.0.0 links its dependency member-lib to the workspace member by
# path; the test declares the member's target through its alias.
bun_test(
    name = "member_test",
    srcs = ["member.test.ts"],
    deps = [
        ":node_modules/member-user",
        "//bun/tests/npm/fixtures/conformance_member_alias/packages/member-lib:pkg",
    ],
)

conformance_files()
