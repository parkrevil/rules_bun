load("@npm_conformance_member_alias//:defs.bzl", "npm_link_all_packages")
load("//bun:defs.bzl", "bun_library", "bun_test")
load("//bun/tests/npm/conformance:files.bzl", "conformance_files")

exports_files([
    "bun.lock",
