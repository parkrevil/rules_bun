load("//bun/tests/support:empty_toolchain.bzl", "empty_toolchain")

package(default_visibility = ["//bun:__subpackages__"])

platform(
    name = "darwin_aarch64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "windows_x64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "darwin_x64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "linux_x64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Linux platforms that say their C library (research R11 of specs/004-bun-1-4-4-upgrade).
platform(
    name = "linux_x64_glibc",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//bun/platforms/libc:glibc",
    ],
)

platform(
    name = "linux_x64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "//bun/platforms/libc:musl",
    ],
)

# An optional package whose os is aix is selected here (T128).
platform(
    name = "aix_x64",
    constraint_values = [
        "@platforms//os:aix",
        "@platforms//cpu:x86_64",
    ],
)

# Platforms no Bun release supports. A hub toolchain that is missing one of its
# constraints matches one of these, so the rejection tests fail.

platform(
    name = "darwin_riscv64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:riscv64",
    ],
)

platform(
    name = "linux_riscv64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:riscv64",
    ],
)

platform(
    name = "windows_riscv64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:riscv64",
    ],
)

platform(
    name = "freebsd_x64",
    constraint_values = [
        "@platforms//os:freebsd",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "freebsd_aarch64",
    constraint_values = [
        "@platforms//os:freebsd",
        "@platforms//cpu:aarch64",
    ],
)

# hermetic_launcher 0.0.16 registers a stub template for this platform, and no
# Bun release supports it.
platform(
    name = "no_bun",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:s390x",
    ],
)

# A Windows platform for which hermetic_launcher 0.0.16 registers no stub
# template (it registers one for Windows on x86_64 only); the tests register a
# Bun for it.
platform(
    name = "no_stub",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

# Lets the test action of a test built for Windows run on any execution platform
# (Test Encyclopedia, "Execution platform": a toolchain registered for
# default_test_toolchain_type takes precedence over Bazel's), so it runs on the
# first registered one, the host. Registered only by the analysis test of a
# bun_test for windows_x64, through --extra_toolchains in its configuration.
empty_toolchain(name = "empty_test_toolchain")

toolchain(
    name = "windows_test_on_host",
    target_compatible_with = ["@platforms//os:windows"],
    toolchain = ":empty_test_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)
