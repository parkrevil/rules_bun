load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//bun:__subpackages__"])

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        ":repositories",
        ":semver",
    ],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    deps = [
        ":toolchains_repo",
        ":versions",
    ],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "library",
    srcs = ["library.bzl"],
    deps = [":providers"],
)

exports_files(
    [
        "isolated_bunfig.toml",
        "launcher.js",
        "launcher.sh.tpl",
    ],
    visibility = ["//bun/tests:__subpackages__"],
)

bzl_library(
    name = "run",
    srcs = ["run.bzl"],
    deps = [
        ":library",
        "@bazel_lib//lib:copy_file",
        "@bazel_skylib//lib:shell",
        "@hermetic_launcher//launcher:lib_bzl",
    ],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "semver",
    srcs = ["semver.bzl"],
)

bzl_library(
    name = "toolchains_repo",
    srcs = ["toolchains_repo.bzl"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
)
