load("@bazel_lib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//bun:__subpackages__"])

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        ":platforms",
        ":repositories",
        ":semver",
    ],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
    deps = [
        ":platforms",
        ":toolchains_repo",
        ":versions",
    ],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "library",
    srcs = ["library.bzl"],
    deps = [":providers"],
)

exports_files(
    [
        "isolated_bunfig.toml",
        "launcher.js",
        "launcher.sh.tpl",
    ],
    visibility = ["//bun/tests:__subpackages__"],
)

bzl_library(
    name = "run",
    srcs = ["run.bzl"],
    deps = [
        ":library",
        "@bazel_lib//lib:copy_directory",
        "@bazel_lib//lib:copy_file",
        "@bazel_skylib//lib:shell",
        "@hermetic_launcher//launcher:lib_bzl",
    ],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//bun:__pkg__"],
)

bzl_library(
    name = "lockfile",
    srcs = ["lockfile.bzl"],
    deps = [":jsonc"],
)

bzl_library(
    name = "resolve",
    srcs = ["resolve.bzl"],
    deps = [":lockfile"],
)

bzl_library(
    name = "npm_extension",
    srcs = ["npm_extension.bzl"],
    deps = [
        ":lockfile",
        ":npm_names",
        ":npm_repositories",
        ":npmrc",
        ":resolve",
        ":workspaces",
    ],
)

bzl_library(
    name = "npm_package",
    srcs = ["npm_package.bzl"],
    deps = [
        ":library",
        ":providers",
        "@bazel_lib//lib:copy_to_directory",
    ],
)

bzl_library(
    name = "overrides",
    srcs = ["overrides.bzl"],
    deps = [":lockfile"],
)

bzl_library(
    name = "workspaces",
    srcs = ["workspaces.bzl"],
    deps = [
        ":lockfile",
        ":overrides",
    ],
)

bzl_library(
    name = "npm_repositories",
    srcs = ["npm_repositories.bzl"],
    deps = [
        ":library",
        ":platforms",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
    ],
)

bzl_library(
    name = "toolchains_repo",
    srcs = ["toolchains_repo.bzl"],
    deps = [":platforms"],
)

bzl_library(
    name = "jsonc",
    srcs = ["jsonc.bzl"],
)

bzl_library(
    name = "npm_names",
    srcs = ["npm_names.bzl"],
)

bzl_library(
    name = "npmrc",
    srcs = ["npmrc.bzl"],
)

bzl_library(
    name = "platforms",
    srcs = ["platforms.bzl"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "semver",
    srcs = ["semver.bzl"],
)

bzl_library(
    name = "versions",
    srcs = ["versions.bzl"],
)
