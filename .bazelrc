import %workspace%/tools/preset.bazelrc

common --config=ruleset
common --lockfile_mode=error

# The inner workspaces of the Bazel-in-Bazel tests are files of
# //bun/tests/integration, not packages of this module, as
# rules_bazel_integration_test arranges child workspaces.
common --deleted_packages=bun/tests/integration/workspaces/toolchain,bun/tests/integration/workspaces/replace/archives,bun/tests/integration/workspaces/replace/other,bun/tests/integration/workspaces/replace/s256,bun/tests/integration/workspaces/replace/s384,bun/tests/integration/workspaces/replace/s512,bun/tests/integration/workspaces/source_nm,bun/tests/integration/workspaces/stale_link,bun/tests/integration/workspaces/winname,bun/tests/integration/workspaces/lockfile_errors,bun/tests/integration/workspaces/manifest_mismatch,bun/tests/integration/workspaces/conflict,bun/tests/integration/workspaces/fetch,bun/tests/integration/workspaces/members,bun/tests/integration/workspaces/members/packages/w1,bun/tests/integration/workspaces/bins,bun/tests/integration/workspaces/restricted,bun/tests/integration/workspaces/registries,bun/tests/integration/workspaces/multi_root,bun/tests/integration/workspaces/multi_root/one,bun/tests/integration/workspaces/multi_root/two,bun/tests/integration/workspaces/multi_dep

# Tests reach only loopback on Linux (linux-sandbox), so the Bazel-in-Bazel
# tests' inner builds are offline (research G5); the preset sets
# --enable_platform_specific_config.
test:linux --modify_execution_info=TestRunner=+block-network

try-import %workspace%/.bazelrc.user
